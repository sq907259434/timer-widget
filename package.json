{
  "name": "timer-card",
  "productName": "TimerCard",
  "version": "1.6.0",
  "description": "倒计时 —— 桌面小卡：滚轮调时间、双击输入、播放/暂停（Electron 独立版）",
  "author": {
    "name": "sq907259434"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js && python tools/pack-ico.py",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.timercard.desktop",
    "productName": "TimerCard",
    "copyright": "Copyright © 2026 sq907259434",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "desktop-layer.js",
      "backdrop.js",
      "preload.js",
      "widget.html",
      "assets",
      "ime.html",
      "ime-preload.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "倒计时",
      "uninstallDisplayName": "倒计时",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "language": "2052",
      "include": "build/installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "asarUnpack": [
      "assets/**"
    ]
  },
  "dependencies": {
    "koffi": "^3.3.5"
  }
}
